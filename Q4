import java.io.InputStream;
import java.io.IOException;
import java.util.Arrays;

public class Main {
    static final int MAXV = 2005;
    static final int MAXE = 2000005;

    // Graph representation (Forward Star)
    static int[] head = new int[MAXV];
    static int[] to = new int[MAXE];
    static int[] weight = new int[MAXE];
    static int[] next = new int[MAXE];
    static int edgeCount = 0;

    // Tarjan's SCC
    static int[] dfn = new int[MAXV];
    static int[] low = new int[MAXV];
    static boolean[] inStack = new boolean[MAXV];
    static int[] stack = new int[MAXV];
    static int[] scc = new int[MAXV];
    static int timer, sccCnt, stackTop;

    // DAG longest path computation
    static int[] headNode = new int[MAXV];
    static int[] nextNode = new int[MAXV];
    static int[] H = new int[MAXV];

    static void addEdge(int u, int v, int w) {
        to[edgeCount] = v;
        weight[edgeCount] = w;
        next[edgeCount] = head[u];
        head[u] = edgeCount++;
    }

    static void tarjan(int u) {
        dfn[u] = low[u] = ++timer;
        stack[stackTop++] = u;
        inStack[u] = true;

        for (int e = head[u]; e != -1; e = next[e]) {
            int v = to[e];
            if (dfn[v] == 0) {
                tarjan(v);
                low[u] = Math.min(low[u], low[v]);
            } else if (inStack[v]) {
                low[u] = Math.min(low[u], dfn[v]);
            }
        }

        if (low[u] == dfn[u]) {
            sccCnt++;
            while (true) {
                int v = stack[--stackTop];
                inStack[v] = false;
                scc[v] = sccCnt;
                if (v == u) break;
            }
        }
    }

    public static void main(String[] args) {
        FastScanner sc = new FastScanner();
        int t = sc.nextInt();
        if (t == -1) return;

        StringBuilder sb = new StringBuilder();

        while (t-- > 0) {
            int n = sc.nextInt();
            int m = sc.nextInt();

            // Reset structures for the current testcase
            edgeCount = 0;
            for (int i = 1; i <= 2 * n; i++) {
                head[i] = -1;
                dfn[i] = 0;
                low[i] = 0;
                inStack[i] = false;
                scc[i] = 0;
            }
            timer = 0;
            sccCnt = 0;
            stackTop = 0;

            // Read restrictions and build edges
            for (int k = 0; k < m; k++) {
                int o = sc.nextInt();
                int i = sc.nextInt();
                int j = sc.nextInt();

                if (o == 1) {
                    // a_i + a_j >= 0
                    addEdge(i + n, j, 0);
                    addEdge(j + n, i, 0);
                } else {
                    // a_i + a_j < 0
                    addEdge(i, j + n, 1);
                    addEdge(j, i + n, 1);
                }
            }

            // Step 1: Run Tarjan's SCC
            for (int i = 1; i <= 2 * n; i++) {
                if (dfn[i] == 0) {
                    tarjan(i);
                }
            }

            // Step 2: Check for positive cycle (weight 1 edge within same SCC)
            boolean hasPositiveCycle = false;
            for (int u = 1; u <= 2 * n; u++) {
                for (int e = head[u]; e != -1; e = next[e]) {
                    int v = to[e];
                    int w = weight[e];
                    if (scc[u] == scc[v] && w == 1) {
                        hasPositiveCycle = true;
                        break;
                    }
                }
                if (hasPositiveCycle) break;
            }

            if (hasPositiveCycle) {
                sb.append("NO\n");
                continue;
            }

            // Step 3: Compute DAG longest path
            for (int i = 1; i <= sccCnt; i++) {
                headNode[i] = -1;
                H[i] = 0;
            }
            for (int u = 1; u <= 2 * n; u++) {
                int c = scc[u];
                nextNode[u] = headNode[c];
                headNode[c] = u;
            }

            // Process SCCs in topological order (from sccCnt down to 1)
            for (int c = sccCnt; c >= 1; c--) {
                for (int u = headNode[c]; u != -1; u = nextNode[u]) {
                    for (int e = head[u]; e != -1; e = next[e]) {
                        int v = to[e];
                        int w = weight[e];
                        if (scc[u] != scc[v]) {
                            H[scc[v]] = Math.max(H[scc[v]], H[c] + w);
                        }
                    }
                }
            }

            // Step 4: Construct solution array
            sb.append("YES\n");
            for (int i = 1; i <= n; i++) {
                int val = H[scc[i]] - H[scc[i + n]];
                sb.append(val).append(i == n ? "" : " ");
            }
            sb.append("\n");
        }

        System.out.print(sb);
    }

    // Fast I/O
    static class FastScanner {
        private final InputStream in = System.in;
        private final byte[] buffer = new byte[1 << 16];
        private int ptr = 0;
        private int buflen = 0;

        private boolean hasNextByte() {
            if (ptr < buflen) return true;
            ptr = 0;
            try {
                buflen = in.read(buffer, 0, buffer.length);
            } catch (IOException e) {
                e.printStackTrace();
            }
            return buflen > 0;
        }

        private int readByte() {
            if (hasNextByte()) return buffer[ptr++];
            return -1;
        }

        public int nextInt() {
            int b = readByte();
            while (b <= ' ') {
                if (b == -1) return -1;
                b = readByte();
            }
            int res = 0;
            while (b >= '0' && b <= '9') {
                res = res * 10 + (b - '0');
                b = readByte();
            }
            return res;
        }
    }
}
